---
import Layout from "../layouts/Layout.astro";
import { projects } from "@/lib/projects";
---

<Layout>
  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-32 lg:items-center justify-center h-full">
    <div>
      <p class="font-mono text-lg md:text-2xl lg:text-3xl xl:text-4xl">
        I've seen things you people wouldn't believe. Attack ships on fire off
        the shoulder of Orion. I watched C-beams glitter in the dark near the
        Tannhäuser Gate. All those moments will be lost in time, like tears in
        rain. Time to die.
      </p>
    </div>
    <div>
      <h2 class="text-2xl font-bold mb-4">Projects</h2>
      <ul>
        {
          projects.map((item) => (
            <li>
              <a
                class="link link-accent link-hover font-semibold"
                href={item.url}>
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>
