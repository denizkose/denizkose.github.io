---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout>
  <h1 class="text-2xl lg:text-4xl font-bold">Contact</h1>
  <p>You can find me on social media:</p>
  <ul>
    <li>
      <a
        href="https://github.com/denizkose"
        aria-label="Github"
        target="_blank"
        class="flex flex-row items-center gap-2 link link-hover"
        ><Icon name="streamline-logos:github-logo-2-solid" class="w-4 h-4" /> Github</a
      >
    </li>
    <li>
      <a
        href="https://t.me/dk_denizkose"
        aria-label="Telegram"
        target="_blank"
        class="flex flex-row items-center gap-2 link link-hover"
        ><Icon name="streamline-logos:telegram-logo-1-solid" class="w-4 h-4" /> Telegram</a
      >
    </li>
  </ul>
</Layout>
